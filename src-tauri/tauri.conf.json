{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Warframe Tracker",
  "version": "0.1.0",
  "identifier": "com.warframetracker",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Warframe Tracker",
        "width": 1000,
        "height": 700,
        "minWidth": 640,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "category": "Game",
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "shortDescription": "Track Warframe mastery and Prime parts"
  }
}
